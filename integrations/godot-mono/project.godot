; Minimal Godot Mono host project for the Clay integration sample.
; Copy the native Clay library into the platform-specific location described
; in README.md before running.
config_version=5

[application]
config/name="Clay Godot Mono Sample"
run/main_scene="res://ClayDemo.tscn"

[display]
window/size/viewport_width=640
window/size/viewport_height=480
window/size/window_width_override=640
window/size/window_height_override=480

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
